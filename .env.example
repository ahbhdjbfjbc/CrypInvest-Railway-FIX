PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/crypinvest
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
CRON_TIMEZONE=UTC

# Legacy wallet variables are retained for backward compatibility only; deposit routing uses Admin > Settings > Deposit Wallets in MongoDB.
TRON_GRID_URL=https://api.trongrid.io
TRON_GRID_API_KEY=
ETHEREUM_RPC_URL=
BSC_RPC_URL=
BSC_API_KEY=

USDT_TRC20_ADDRESS=

USDT_TRC20_CONFIRMATIONS=12
USDT_ERC20_ADDRESS=
USDT_ERC20_CONFIRMATIONS=12
USDT_BEP20_ADDRESS=
USDT_BEP20_CONFIRMATIONS=15
USDT_TRC20_CONTRACT=
USDT_ERC20_CONTRACT=
# BEP20 USDT is disabled: Tether does not publish an official USD₮ contract for BNB Smart Chain.

PAYMENT_PROVIDER_NAME=admin-provider
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_ENVIRONMENT=sandbox
# Set production only after the provider, webhook signing, and withdrawal workflow are independently verified.
PAYMENT_PROVIDER_METHOD=POST
PAYMENT_PROVIDER_WITHDRAWAL_PATH=/withdrawals
PAYMENT_PROVIDER_AUTH_HEADER=Authorization
PAYMENT_PROVIDER_AMOUNT_FIELD=amount
PAYMENT_PROVIDER_DESTINATION_FIELD=destination
PAYMENT_PROVIDER_NETWORK_FIELD=network
PAYMENT_PROVIDER_CURRENCY_FIELD=currency
PAYMENT_PROVIDER_IDEMPOTENCY_HEADER=Idempotency-Key

REQUIRE_ADMIN_2FA=true
REQUIRE_KYC_FOR_WITHDRAWALS=true
REQUIRE_KYC_FOR_INVESTMENTS=true

# One-time admin bootstrap (used only by: npm run bootstrap:admin)
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
# Required for encrypted database backups (32-byte hex)
BACKUP_ENCRYPTION_KEY=

